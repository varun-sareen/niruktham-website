---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import { postSlug } from '../../utils/slug';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Writing — Niruktham" description="Notes on ServiceNow REST APIs, GlideRecord, the Now Platform, and the occasional deep-dive.">
  <SiteHeader />
  <main class="container">
    <div class="inner">
      <h1>Writing</h1>
      <p class="subtitle">Notes from LinkedIn, mirrored here.</p>

      <div class="post-list">
      {posts.map((post) => {
        const slug = postSlug(post.id);
        return (
          <article class="post-entry">
            <div class="post-meta">
              <span class="category-tag">{post.data.category}</span>
              <span class="post-date">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </div>
            <a href={`/posts/${slug}/`} class="post-title">
              <h2>{post.data.title}</h2>
            </a>
            <p class="post-excerpt">{post.data.excerpt}</p>
          </article>
        );
      })}
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 44px;
  }

  .inner {
    max-width: 720px;
    margin: 0 auto;
  }

  h1 {
    font-size: 36px;
    font-weight: 500;
    color: #fafafa;
    letter-spacing: -0.02em;
    margin: 0 0 4px;
  }

  .subtitle {
    font-size: 15px;
    color: #6a6a6a;
    margin: 0 0 36px;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-entry {
    padding-bottom: 24px;
    margin-bottom: 24px;
    border-bottom: 0.5px solid #2a2a2a;
  }

  .post-entry:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
  }

  .category-tag {
    display: inline-block;
    font-size: 12px;
    padding: 2px 8px;
    background: #1a1a1a;
    color: #d4a574;
    border: 0.5px solid #2a2a2a;
    border-radius: 3px;
    font-weight: 500;
  }

  .post-date {
    font-size: 13px;
    color: #6a6a6a;
  }

  .post-title {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .post-title h2 {
    font-size: 22px;
    font-weight: 500;
    color: #fafafa;
    line-height: 1.3;
    margin: 0 0 6px;
  }

  .post-title:hover h2 {
    color: #d4a574;
  }

  .post-excerpt {
    font-size: 16px;
    line-height: 1.65;
    color: #a0a0a0;
    margin: 0;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 24px;
    }
  }
</style>
