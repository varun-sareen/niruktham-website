<style>
  .site-footer {
    background: #0a0a0a;
    padding: 3rem 0 1.75rem;
    font-family: Inter, system-ui, sans-serif;
    border-top: 1px solid #1f1f1f;
    margin-top: 1rem;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid #1a1a1a;
  }

  .footer-brand {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .footer-leaf {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    align-self: center;
  }

  .footer-name {
    font-size: 18px;
    font-weight: 500;
    color: #fafafa;
    letter-spacing: -0.01em;
  }

  .footer-dev {
    font-family: 'Noto Sans Devanagari', serif;
    font-size: 15px;
    color: #c4b890;
    font-style: italic;
    margin-left: 0.65rem;
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.15s ease;
  }

  .social-link:hover {
    opacity: 1;
  }

  .social-linkedin { color: #0a66c2; }
  .social-github { color: #fafafa; }
  .social-rss { color: #ee802f; }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.25rem;
    font-size: 14px;
    color: #888;
  }

  .footer-copy {
    margin: 0;
  }

  .footer-credit {
    margin: 0;
  }

  .footer-credit a {
    color: #c4b890;
    text-decoration: none;
  }

  .footer-credit a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .footer-inner {
      padding: 0 1.5rem;
    }

    .footer-top {
      flex-direction: column;
      gap: 1.25rem;
      align-items: flex-start;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start;
    }
  }
</style>
