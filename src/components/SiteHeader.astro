---
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/posts/', label: 'Blog', muted: false },
  { href: '/coming-soon/', label: 'Solutions', muted: true },
  { href: '/coming-soon/', label: 'About', muted: true },
];

const isActive = (href: string) => {
  if (href === '/posts/') {
    return pathname === '/posts' || pathname === '/posts/' || pathname.startsWith('/posts/');
  }
  return pathname === href || pathname === href.replace(/\/$/, '');
};
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <svg viewBox="0 0 28 30" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Niruktham logo — a leaf above a small root tree" style="width: 40px; height: auto; flex-shrink: 0;">
        <path d="M 14 11 Q 8 7 13 0 Q 14 -1 15 0 Q 20 7 14 11 Z" fill="#8ab068" stroke="#4a6a2a" stroke-width="0.7" stroke-linejoin="round"/>
        <line x1="14" y1="11" x2="14" y2="14" stroke="#5a7a3a" stroke-width="0.6"/>
        <g fill="none" stroke="#d4a574" stroke-width="0.7" stroke-linecap="round">
          <line x1="14" y1="14" x2="14" y2="28"/>
          <path d="M 14 18 Q 9 21 5 26"/>
          <path d="M 14 18 Q 19 21 23 26"/>
          <path d="M 14 23 Q 11 25 9 28"/>
          <path d="M 14 23 Q 17 25 19 28"/>
        </g>
        <circle cx="14" cy="14" r="0.9" fill="#d4a574"/>
      </svg>
      <span class="brand-name">Niruktham</span>
      <span class="brand-dev">निरुक्तम्</span>
    </a>
    <nav class="site-nav">
      {navItems.map((item) => {
        const active = !item.muted && isActive(item.href);
        const classes = [
          'nav-link',
          item.muted ? 'nav-link-muted' : '',
          active ? 'nav-link-active' : '',
        ].filter(Boolean).join(' ');
        return (
          <a href={item.href} class={classes} aria-current={active ? 'page' : undefined}>{item.label}</a>
        );
      })}
    </nav>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    padding: 24px 0;
    margin-bottom: 56px;
    border-bottom: 0.5px solid #2a2a2a;
  }

  .header-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 44px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s;
  }

  .brand:hover {
    opacity: 0.85;
  }

  .brand-name {
    font-size: 24px;
    font-weight: 500;
    color: #fafafa;
    letter-spacing: -0.02em;
  }

  .brand-dev {
    font-family: 'Noto Sans Devanagari', serif;
    font-size: 14px;
    color: #d4a574;
  }

  .site-nav {
    display: flex;
    gap: 32px;
    align-items: center;
  }

  .nav-link {
    font-size: 15px;
    color: #a0a0a0;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: #fafafa;
  }

  .nav-link-active {
    color: #fafafa;
  }

  .nav-link-muted {
    color: #6a6a6a;
  }

  .nav-link-muted:hover {
    color: #a0a0a0;
  }

  @media (max-width: 768px) {
    .header-inner {
      padding: 0 24px;
    }

    .site-nav {
      gap: 16px;
    }

    .nav-link {
      font-size: 13px;
    }
  }
</style>
