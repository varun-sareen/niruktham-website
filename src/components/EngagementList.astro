---
export type Engagement = {
  id: string;
  title: string;
  pills: string[];
  role: string;
  period: string;
  modules: string;
  description: string;
};

interface Props {
  engagements: Engagement[];
}

const { engagements } = Astro.props;
---

<ul class="engagement-list">
  {engagements.map((e) => (
    <li class="engagement" id={e.id}>
      <button
        type="button"
        class="engagement-toggle"
        aria-expanded="true"
        aria-controls={`${e.id}-detail`}
      >
        <span class="engagement-row">
          <span class="engagement-row-main">
            <span class="engagement-title">{e.title}</span>
            <span class="engagement-pills">
              {e.pills.map((p) => <span class="pill">{p}</span>)}
            </span>
            <span class="engagement-role">{e.role}</span>
          </span>
          <span class="engagement-row-end">
            <span class="engagement-dates">{e.period}</span>
            <span class="engagement-toggle-icon" aria-hidden="true">−</span>
          </span>
        </span>
      </button>
      <div class="engagement-detail" id={`${e.id}-detail`}>
        <dl class="engagement-meta">
          <dt>Period</dt>
          <dd>{e.period}</dd>
          <dt>Modules</dt>
          <dd>{e.modules}</dd>
          <dt>Role</dt>
          <dd>{e.role}</dd>
        </dl>
        <p class="engagement-description">{e.description}</p>
        <a href="/coming-soon/" class="engagement-solution-link">&rarr; Solution writeup</a>
      </div>
    </li>
  ))}
</ul>

<style>
  .engagement-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .engagement {
    scroll-margin-top: 32px;
    border-bottom: 0.5px solid #1f1f1f;
  }

  .engagement-toggle {
    width: 100%;
    background: none;
    border: none;
    padding: 16px 0;
    margin: 0;
    cursor: pointer;
    text-align: left;
    color: inherit;
    font: inherit;
  }

  .engagement-toggle:focus {
    outline: none;
  }

  .engagement-toggle:focus-visible {
    outline: 1px solid #d4a574;
    outline-offset: 4px;
    border-radius: 2px;
  }

  .engagement-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .engagement-row-main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 14px;
    row-gap: 8px;
    flex: 1;
    min-width: 0;
  }

  .engagement-row-end {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .engagement-title {
    font-size: 17px;
    font-weight: 500;
    color: #fafafa;
    transition: color 0.15s ease;
  }

  .engagement-toggle:hover .engagement-title,
  .engagement-toggle:hover .engagement-toggle-icon {
    color: #d4a574;
  }

  .engagement-pills {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .pill {
    background: rgba(212, 165, 116, 0.15);
    color: #d4a574;
    border: 0.5px solid rgba(212, 165, 116, 0.35);
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3px;
    border-radius: 3px;
    line-height: 1.5;
  }

  .engagement-role {
    font-size: 13px;
    color: #6a6a6a;
  }

  .engagement-dates {
    font-size: 13px;
    color: #a0a0a0;
    font-variant-numeric: tabular-nums;
  }

  .engagement-toggle-icon {
    display: inline-block;
    width: 28px;
    text-align: center;
    font-size: 36px;
    font-weight: 400;
    color: #6a6a6a;
    line-height: 1;
    transition: color 0.15s ease;
  }

  .engagement-detail {
    padding: 4px 0 24px;
  }

  .engagement-detail[hidden] {
    display: none;
  }

  .engagement-meta {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 6px;
    margin: 0 0 16px;
  }

  .engagement-meta dt {
    font-size: 11px;
    font-weight: 500;
    color: #6a6a6a;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-top: 3px;
  }

  .engagement-meta dd {
    margin: 0;
    font-size: 14px;
    color: #cfcfcf;
    line-height: 1.5;
  }

  .engagement-description {
    font-size: 17px;
    line-height: 1.75;
    color: #cfcfcf;
    margin: 0 0 16px;
  }

  .engagement-solution-link {
    display: inline-block;
    font-size: 14px;
    color: #d4a574;
    text-decoration: none;
    border-bottom: 0.5px solid rgba(212, 165, 116, 0.5);
    transition: border-color 0.15s ease, opacity 0.15s ease;
  }

  .engagement-solution-link:hover {
    border-bottom-color: #d4a574;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .engagement-row {
      flex-wrap: wrap;
    }

    .engagement-row-end {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (max-width: 480px) {
    .engagement-meta {
      grid-template-columns: 1fr;
      row-gap: 2px;
    }

    .engagement-meta dt {
      padding-top: 10px;
    }

    .engagement-meta dt:first-of-type {
      padding-top: 0;
    }
  }
</style>
